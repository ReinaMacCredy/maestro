      "read_only": true,
      "writes": false,
      "network_io": false,
      "request_schema": "McpCliSearchRequestV1",
      "response_schema": "McpCliSearchEnvelopeV1",
      "cursor_contract": "Complete=Absent; BoundedTruncated=Present",
      "hit_classifications": [
        "PureRead",
        "Action",
        "Ceremony"
      ]
