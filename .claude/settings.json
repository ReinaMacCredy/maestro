{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/maestro-record.ts",
            "statusMessage": "Loading maestro state"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/maestro-record.ts",
            "statusMessage": "Loading maestro state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/maestro-record.ts"
          }
        ]
      }
    ]
  }
}
