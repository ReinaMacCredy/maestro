{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maestro.external.vnext-final-fault-observation.v1",
  "type": "object",
  "required": ["schema_version", "proof_id", "schedule_identity", "observed_reached_points", "point_receipts"],
  "properties": {
    "schema_version": {"const": "maestro.external.vnext-final-fault-observation.v1"},
    "proof_id": {"type": "string", "pattern": "^s(0|[1-9]|1[0-2])-[a-z0-9-]+$"},
    "schedule_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_reached_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "point_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["point", "path", "byte_length", "sha256"],
        "properties": {
          "point": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"},
          "byte_length": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
