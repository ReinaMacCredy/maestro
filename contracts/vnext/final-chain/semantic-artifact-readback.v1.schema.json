{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maestro.external.vnext-final-semantic-artifact-readback.v1",
  "type": "object",
  "required": ["schema_version", "check_id", "artifacts", "canonical_reads", "negative_routes", "closures", "promotion_parity"],
  "properties": {
    "schema_version": {"const": "maestro.external.vnext-final-semantic-artifact-readback.v1"},
    "check_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "root", "path", "byte_length", "sha256"],
        "properties": {
          "kind": {"enum": ["compiled", "exported", "schema", "resource", "persisted", "consumer", "reader", "hold"]},
          "root": {"enum": ["source", "target", "output"]},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"},
          "byte_length": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "canonical_reads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "status", "command_identity", "observation"],
        "properties": {
          "route": {"type": "string", "minLength": 1},
          "status": {"const": "pass"},
          "command_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "observation": {"$ref": "#/$defs/binding"}
        },
        "additionalProperties": false
      }
    },
    "negative_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "injected", "outcome", "receipt_identity", "observation"],
        "properties": {
          "route": {"type": "string", "minLength": 1},
          "injected": {"const": true},
          "outcome": {"const": "refuse"},
          "receipt_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "observation": {"$ref": "#/$defs/binding"}
        },
        "additionalProperties": false
      }
    },
    "closures": {
      "type": "object",
      "required": ["consumer_count", "reader_count", "hold_count"],
      "properties": {
        "consumer_count": {"const": 0},
        "reader_count": {"const": 0},
        "hold_count": {"const": 0}
      },
      "additionalProperties": false
    },
    "promotion_parity": {
      "type": "object",
      "required": ["source_file_count", "promoted_file_count", "mismatch_count"],
      "properties": {
        "source_file_count": {"const": 210},
        "promoted_file_count": {"const": 210},
        "mismatch_count": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
