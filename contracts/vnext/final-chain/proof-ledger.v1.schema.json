{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maestro.external.vnext-final-proof-ledger.v1",
  "type": "object",
  "required": ["schema_version", "proofs"],
  "properties": {
    "schema_version": {"const": "maestro.external.vnext-final-proof-ledger.v1"},
    "proofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["proof_id", "stage", "kind", "expected_outcome", "engines", "command"],
        "properties": {
          "proof_id": {"type": "string", "pattern": "^s(0|[1-9]|1[0-2])-[a-z0-9][a-z0-9-]*$"},
          "stage": {"type": "integer", "minimum": 0, "maximum": 12},
          "kind": {"enum": ["behavior", "negative", "mutant", "authority", "race", "crash_replay", "idempotency", "migration", "rollback", "adapter", "identity", "removal", "closure"]},
          "expected_outcome": {"enum": ["pass", "refuse"]},
          "engines": {"type": "array", "items": {"enum": ["python", "rust", "ruby"]}, "minItems": 3, "uniqueItems": true},
          "command": {
            "type": "object",
            "required": ["argv", "expected_exit_code"],
            "properties": {
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "expected_exit_code": {"type": "integer"},
              "fixture_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "fault_schedule": {"type": "string", "minLength": 1},
              "cohort": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
