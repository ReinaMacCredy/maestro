{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maestro.external.vnext-final-proof-ledger.v1",
  "type": "object",
  "required": ["schema_version", "snapshot_commit", "proof_count", "proofs"],
  "properties": {
    "schema_version": {"const": "maestro.external.vnext-final-proof-ledger.v1"},
    "snapshot_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proof_count": {"type": "integer", "minimum": 13},
    "proofs": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "required": ["proof_id", "stage", "kind", "expected_outcome", "engines", "command", "input_bindings", "produced_artifacts"],
        "properties": {
          "proof_id": {"type": "string", "pattern": "^s(0|[1-9]|1[0-2])-[a-z0-9][a-z0-9-]*$"},
          "stage": {"type": "integer", "minimum": 0, "maximum": 12},
          "kind": {"enum": ["behavior", "negative", "mutant", "authority", "race", "crash_replay", "idempotency", "migration", "rollback", "adapter", "identity", "removal", "closure"]},
          "expected_outcome": {"enum": ["pass", "refuse"]},
          "engines": {"const": ["python", "rust", "ruby"]},
          "command": {
            "type": "object",
            "required": ["argv", "expected_exit_code", "identity"],
            "properties": {
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "expected_exit_code": {"type": "integer"},
              "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "fault_schedule": {"$ref": "#/$defs/bound_file"},
              "cohort": {
                "type": "object",
                "required": ["old_reader", "new_reader", "writer", "fixture"],
                "properties": {
                  "old_reader": {"type": "string", "minLength": 1},
                  "new_reader": {"type": "string", "minLength": 1},
                  "writer": {"type": "string", "minLength": 1},
                  "fixture": {"$ref": "#/$defs/bound_file"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "input_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bound_file"}},
          "produced_artifacts": {"type": "array", "items": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "bound_file": {
      "type": "object",
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"},
        "byte_length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
