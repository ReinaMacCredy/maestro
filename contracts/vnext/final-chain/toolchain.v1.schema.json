{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maestro.external.vnext-final-toolchain.v1",
  "type": "object",
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": "maestro.external.vnext-final-toolchain.v1"},
    "tools": {
      "type": "object",
      "required": ["python", "rust", "ruby"],
      "properties": {
        "python": {"$ref": "#/$defs/tool"},
        "rust": {"$ref": "#/$defs/tool"},
        "ruby": {"$ref": "#/$defs/tool"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["sha256", "probe"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "probe": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
