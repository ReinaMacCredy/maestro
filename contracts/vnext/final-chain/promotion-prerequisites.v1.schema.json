{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maestro.external.vnext-final-promotion-prerequisites.v1",
  "type": "object",
  "required": [
    "schema_version",
    "stage11_commit",
    "stage12_reviewed_candidate",
    "stage11_migration_filter",
    "stage11_rollback_filter",
    "stage12_readback_filter",
    "stage12_removal_filter",
    "legacy_prune_gate",
    "consumer_reader_hold",
    "promotion_parity"
  ],
  "properties": {
    "schema_version": {
      "const": "maestro.external.vnext-final-promotion-prerequisites.v1"
    },
    "stage11_commit": {
      "$ref": "#/$defs/sha1"
    },
    "stage12_reviewed_candidate": {
      "$ref": "#/$defs/sha1"
    },
    "stage11_migration_filter": {
      "$ref": "#/$defs/filter"
    },
    "stage11_rollback_filter": {
      "$ref": "#/$defs/filter"
    },
    "stage12_readback_filter": {
      "$ref": "#/$defs/filter"
    },
    "stage12_removal_filter": {
      "$ref": "#/$defs/filter"
    },
    "legacy_prune_gate": {
      "type": "object",
      "required": ["status", "observed_legacy_row_count", "receipt"],
      "properties": {
        "status": {"const": "pass"},
        "observed_legacy_row_count": {"const": 0},
        "receipt": {"$ref": "#/$defs/binding"}
      },
      "additionalProperties": false
    },
    "consumer_reader_hold": {
      "type": "object",
      "required": ["consumer_count", "reader_count", "hold_count", "receipt"],
      "properties": {
        "consumer_count": {"const": 0},
        "reader_count": {"const": 0},
        "hold_count": {"const": 0},
        "receipt": {"$ref": "#/$defs/binding"}
      },
      "additionalProperties": false
    },
    "promotion_parity": {
      "type": "object",
      "required": ["source_file_count", "promoted_file_count", "mismatch_count", "receipt"],
      "properties": {
        "source_file_count": {"const": 210},
        "promoted_file_count": {"const": 210},
        "mismatch_count": {"const": 0},
        "receipt": {"$ref": "#/$defs/binding"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "filter": {"type": "string", "pattern": "^domain::vnext::[a-z0-9_:]+::tests::[a-z0-9_]+$"},
    "binding": {
      "type": "object",
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
