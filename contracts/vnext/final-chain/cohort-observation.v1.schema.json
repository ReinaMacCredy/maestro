{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maestro.external.vnext-final-cohort-observation.v1",
  "type": "object",
  "required": ["schema_version", "proof_id", "cohort_identity", "executables", "outcomes"],
  "properties": {
    "schema_version": {"const": "maestro.external.vnext-final-cohort-observation.v1"},
    "proof_id": {"type": "string", "pattern": "^s11-[a-z0-9-]+$"},
    "cohort_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executables": {
      "type": "object",
      "required": ["old_reader", "new_reader", "writer"],
      "properties": {
        "old_reader": {"$ref": "#/$defs/rooted_binding"},
        "new_reader": {"$ref": "#/$defs/rooted_binding"},
        "writer": {"$ref": "#/$defs/rooted_binding"}
      },
      "additionalProperties": false
    },
    "outcomes": {
      "type": "object",
      "required": ["old_reader", "new_reader", "writer", "rollback"],
      "properties": {
        "old_reader": {"$ref": "#/$defs/outcome"},
        "new_reader": {"$ref": "#/$defs/outcome"},
        "writer": {"$ref": "#/$defs/outcome"},
        "rollback": {"$ref": "#/$defs/outcome"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "rooted_binding": {
      "type": "object",
      "required": ["root", "path", "byte_length", "sha256"],
      "properties": {
        "root": {"enum": ["source", "target", "output"]},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+$"},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "outcome": {
        "type": "object",
        "required": ["typed_result", "observation"],
        "properties": {
          "typed_result": {"type": "string", "minLength": 1},
          "observation": {"$ref": "#/$defs/binding"}
        },
        "additionalProperties": false
    }
  },
  "additionalProperties": false
}
